{
  "kind": "command_classes",
  "_doc": "Rows with \"raw\": true match the command with heredocs removed but quoted strings kept (loops hidden in bash -c '...'). Data-file names (*.log, *.json ...) are blanked before matching so tool names inside file names do not classify a command. Ordered table: the FIRST rule whose regex matches the sanitized Bash command wins (quoted strings and heredoc bodies are removed before matching). Order is therefore priority: put heavy/slow classes first. A row may have \"unless\": a regex that skips the row when it also matches ('rm -f x.done; bash run.sh' is a script run, not a file operation). Add your own rows; unknown commands fall into shell_other.",
  "rules": [
    {"class": "service", "regex": "\\b(serve\\b|runserver|http\\.server|uvicorn|gunicorn|hypercorn|flask\\s+run|streamlit\\s+run|storybook|jupyter|next\\s+(dev|start)|vite(\\s+dev|\\s+preview)?\\s*($|[;&|])|(npm|pnpm|yarn|bun)\\s+(run\\s+)?(dev|start|serve|watch)\\b|--watch\\b)", "_doc": "long-running servers and watchers: when started in the background they run until killed, so their lifetime is not time the run was blocked"},
    {"class": "human_wait:approval", "regex": "\\b(GATE_REASON|APPROVAL_REASON)=", "_doc": "commands run through a human-approval gate (env prefix such as GATE_REASON=...): the wait is a person approving, not machine time. Add your own gate variable here."},
    {"class": "poll_wait", "regex": "(^|[;&|(]\\s*)(bash\\s+|sh\\s+|\\./)?\\S*/?(wait|poll)[\\w.-]*\\.(sh|py)\\b|\\bwait[-_]for[-_]?\\w*\\b"},
    {"class": "poll_wait", "raw": true, "regex": "\\b(until|while)\\b[^\\n]{0,200}\\bsleep\\s+[0-9]|\\bsleep\\s+[0-9]+\\s*(;|&&)\\s*(gh|curl|cat|tail|ls|test|\\[)\\b|\\bfor\\b[^\\n]{0,80}\\bdo\\b[^\\n]{0,200}\\bsleep\\s+[0-9]|\\btimeout\\s+[0-9]+\\s+(bash|sh)\\s+-c\\s+.{0,40}\\b(until|while)\\b"},
    {"class": "poll_wait", "regex": "(^|[;&|(]\\s*)(sleep\\s+[0-9]|timeout\\s+[0-9]+\\s+sleep)|\\buntil\\b[^;]*;\\s*do\\s+sleep|\\bwhile\\b[^;]*;\\s*do\\s+sleep|\\btimeout\\s+[0-9]+\\s+cat\\s+\\S*fifo|\\bread\\s+(-\\w+\\s+)*-t\\s*[0-9]+|\\bgh\\s+run\\s+watch|\\bgh\\s+pr\\s+checks\\s+--watch|\\bwatch\\s+-n"},
    {"class": "media_gpu", "regex": "\\b(ffmpeg|whisper|faster[-_]whisper|whisper[-.]?cpp|demucs|nvenc|blender|remotion|manim|comfyui|stable[-_]diffusion|yolo|torchrun|vllm|ollama\\s+run|handbrake|imagemagick|magick\\s+convert|montage|realesrgan|upscayl|tesseract|ocrmypdf)\\b|\\bpython3?\\b[^|;&]*\\b(torch|cuda|transformers|diffusers)\\b"},
    {"class": "browser_automation", "regex": "\\b(playwright|puppeteer|cypress|selenium|chromium|chrome|webdriver|lighthouse)\\b(?!.*\\btest\\b)"},
    {"class": "install", "regex": "\\b(npm\\s+(ci|install|i|add|update)|pnpm\\s+(i|install|add|update)|yarn(\\s+(install|add|upgrade))?\\s*($|[;&|])|bun\\s+(i|install|add)|pip3?\\s+install|python3?\\s+-m\\s+pip\\s+install|uv\\s+(pip|sync|add|venv)|poetry\\s+(install|add)|apt(-get)?\\s+(install|update|upgrade)|brew\\s+install|cargo\\s+(install|fetch)|gem\\s+install|bundle\\s+install|go\\s+(mod\\s+download|get|install)|composer\\s+install|playwright\\s+install|npx\\s+playwright\\s+install|conda\\s+install)\\b"},
    {"class": "test", "regex": "\\b(jest|vitest|pytest|py\\.test|mocha|rspec|phpunit|ava|karma|cypress\\s+run|playwright\\s+test|go\\s+test|cargo\\s+(test|nextest)|dotnet\\s+test|gradlew?\\s+test|mvn\\s+test|python3?\\s+-m\\s+(unittest|pytest)|unittest\\s+discover|(npm|pnpm|yarn|bun)\\s+(run\\s+)?(test|e2e|test:[a-z:]+)|make\\s+test|tox|nox)\\b"},
    {"class": "build", "regex": "\\b(next\\s+build|vite\\s+build|webpack|rspack|rollup|esbuild|parcel|turbo(repo)?\\s+(run\\s+)?build|(npm|pnpm|yarn|bun)\\s+(run\\s+)?(build|compile|bundle|export)[a-z:]*|tsc\\s+(-b|--build)|cargo\\s+(build|check)|go\\s+build|gradlew?\\b|mvn\\b|cmake|ninja|make(\\s|$)|docker\\s+(compose\\s+)?build|docker\\s+buildx|dotnet\\s+build|swift\\s+build|xcodebuild|bazel|pyinstaller|python3?\\s+-m\\s+build|maturin|cdk\\s+synth|sam\\s+build|expo\\s+(export|prebuild)|eas\\s+build)\\b"},
    {"class": "lint_typecheck", "regex": "\\b(eslint|prettier|biome|oxlint|tsc|tsgo|mypy|pyright|ruff|flake8|pylint|black|isort|stylelint|next\\s+lint|cargo\\s+clippy|golangci-lint|shellcheck|(npm|pnpm|yarn|bun)\\s+(run\\s+)?(lint|typecheck|type-check|check|format)[a-z:]*)\\b"},
    {"class": "network", "regex": "\\b(curl|wget|http|httpie|ssh|scp|sftp|rsync|ping|dig|nslookup|traceroute|nc|ncat|gh\\s+(api|release|repo\\s+clone|pr\\s+(create|merge)|issue)|aws|gcloud|az|kubectl|helm|coolify|vercel|wrangler|flyctl|netlify|heroku|stripe|supabase|terraform|docker\\s+(pull|push|login)|npm\\s+(publish|view|info)|yt-dlp|youtube-dl|aria2c|rclone|mc\\s+cp|s3cmd|notion|gmail|telnet)\\b"},
    {"class": "git", "regex": "(^|[;&|(]\\s*)(git|gh)\\s"},
    {"class": "container", "regex": "\\b(docker|podman|docker-compose|compose|nerdctl)\\b"},
    {"class": "file_ops", "regex": "^\\s*(cd\\s+\\S+\\s*(&&|;)\\s*)?(ls|cat|head|tail|grep|egrep|rg|find|fd|sed|awk|cp|mv|rm|mkdir|rmdir|touch|chmod|chown|ln|wc|sort|uniq|diff|cmp|tar|unzip|zip|gzip|du|df|stat|file|tee|jq|yq|basename|dirname|realpath|readlink|cut|tr|xargs|tree|echo|printf|pwd|test|which|env|date|true|:|\\[)\\b", "unless": "(^|[;&|(]\\s*)(python3?|node|deno|bun|tsx|ts-node|ruby|perl|php|bash|sh|zsh|\\./[a-z0-9_./-]+)\\s"},
    {"class": "script_run", "regex": "\\b(python3?|node|deno|bun|tsx|ts-node|ruby|perl|php|bash|sh|zsh|\\./[a-z0-9_./-]+)\\b"}
  ],
  "tool_classes": {
    "Read": "file_ops", "Write": "file_ops", "Edit": "file_ops", "MultiEdit": "file_ops", "NotebookEdit": "file_ops",
    "Glob": "file_ops", "Grep": "file_ops", "LS": "file_ops",
    "WebFetch": "web", "WebSearch": "web",
    "Agent": "subagent_wait", "Task": "subagent_wait", "Workflow": "subagent_wait",
    "AskUserQuestion": "human_wait:ask", "ExitPlanMode": "human_wait:ask",
    "ToolSearch": "harness", "Skill": "harness", "TodoWrite": "harness", "TaskCreate": "harness", "TaskUpdate": "harness",
    "SendMessage": "harness", "ListAgents": "harness", "TaskStop": "harness", "PushNotification": "harness",
    "Monitor": "poll_wait", "ScheduleWakeup": "poll_wait", "Sleep": "poll_wait"
  },
  "mcp_name_classes": [
    {"class": "browser_automation", "regex": "(playwright|puppeteer|browser|chrome|computer[-_]use|desktop_|screenshot)"},
    {"class": "human_wait:ask", "regex": "(request_human|wait_for_human)"}
  ],
  "read_only_bash": "^\\s*(cd\\s+\\S+\\s*(&&|;)\\s*)?(ls|cat|head|tail|grep|rg|find|fd|wc|stat|file|tree|pwd|which|echo|date|git\\s+(status|log|diff|show|branch|rev-parse|remote)|jq|du|df)\\b",
  "mechanical_classes": ["file_ops", "git", "harness"]
}
