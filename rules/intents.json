{
  "kind": "intents",
  "_doc": "What a shell command likely did, used when the agent gave no description. Tested on the command with quoted strings and heredoc bodies removed. Every match is reported, in command order, up to three.",
  "rules": [
    {"regex": "\\bnext\\s+build\\b", "text": "production build of a Next.js app"},
    {"regex": "\\bnext\\s+dev\\b", "text": "start the Next.js dev server"},
    {"regex": "\\bnext\\s+typegen\\b", "text": "generate Next.js route types"},
    {"regex": "\\btsc\\b", "text": "TypeScript type check"},
    {"regex": "\\beslint\\b", "text": "ESLint run"},
    {"regex": "\\bprettier\\b", "text": "format check with Prettier"},
    {"regex": "\\bbiome\\b", "text": "lint and format with Biome"},
    {"regex": "\\bruff\\b", "text": "Python lint with Ruff"},
    {"regex": "\\bmypy\\b|\\bpyright\\b", "text": "Python type check"},
    {"regex": "\\bplaywright\\s+test\\b", "text": "browser end-to-end tests"},
    {"regex": "\\bplaywright\\b", "text": "drive a browser with Playwright"},
    {"regex": "\\b(vitest|jest|mocha)\\b", "text": "JavaScript test suite"},
    {"regex": "\\bpytest\\b|\\bunittest\\b", "text": "Python test suite"},
    {"regex": "\\b(go|cargo)\\s+test\\b", "text": "compiled-language test suite"},
    {"regex": "\\b(npm|pnpm|yarn|bun)\\s+(ci|install|i|add)\\b", "text": "install JavaScript dependencies"},
    {"regex": "\\b(npm|pnpm|yarn|bun)\\s+(run\\s+)?build\\b", "text": "package build script"},
    {"regex": "\\b(npm|pnpm|yarn|bun)\\s+(run\\s+)?test\\b", "text": "package test script"},
    {"regex": "\\b(npm|pnpm|yarn|bun)\\s+(run\\s+)?dev\\b", "text": "start a dev server"},
    {"regex": "\\bpip3?\\s+install\\b|\\buv\\s+(pip|add|sync)\\b", "text": "install Python packages"},
    {"regex": "\\bapt(-get)?\\s+install\\b", "text": "install system packages"},
    {"regex": "\\bdocker\\s+(compose\\s+)?build\\b|\\bdocker\\s+buildx\\b", "text": "build a container image"},
    {"regex": "\\bdocker\\b", "text": "container operation"},
    {"regex": "\\bffmpeg\\b", "text": "encode or cut audio/video with ffmpeg"},
    {"regex": "\\bffprobe\\b", "text": "read media metadata"},
    {"regex": "\\bwhisper\\b", "text": "speech-to-text transcription"},
    {"regex": "\\byt-dlp\\b", "text": "download online video"},
    {"regex": "\\bremotion\\b", "text": "render a Remotion video"},
    {"regex": "\\brclone\\b", "text": "transfer files to or from cloud storage"},
    {"regex": "\\brsync\\b|\\bscp\\b", "text": "copy files between machines"},
    {"regex": "\\bssh\\b", "text": "run a command on a remote machine"},
    {"regex": "\\bcurl\\b|\\bwget\\b", "text": "HTTP request or download"},
    {"regex": "\\bgh\\s+run\\b", "text": "inspect a CI run"},
    {"regex": "\\bgh\\s+pr\\b", "text": "pull request operation"},
    {"regex": "\\bgh\\b", "text": "GitHub CLI call"},
    {"regex": "\\bgit\\s+clone\\b", "text": "clone a repository"},
    {"regex": "\\bgit\\s+commit\\b", "text": "commit changes"},
    {"regex": "\\bgit\\s+push\\b", "text": "push to the remote"},
    {"regex": "\\bgit\\s+(pull|fetch)\\b", "text": "fetch from the remote"},
    {"regex": "\\bgit\\s+(status|diff|log|show)\\b", "text": "inspect git state"},
    {"regex": "\\bgit\\s+worktree\\b", "text": "manage git worktrees"},
    {"regex": "\\bgit\\s+[a-z]+", "text": "git operation"},
    {"regex": "\\b(rg|grep|egrep)\\b", "text": "search text"},
    {"regex": "(^|[;&|(]\\s*)(find|fd)\\s", "text": "find files"},
    {"regex": "(^|[;&|(]\\s*)du\\s|(^|[;&|(]\\s*)df\\s", "text": "check disk use"},
    {"regex": "(^|[;&|(]\\s*)(cat|head|tail|sed|awk|wc|ls)\\s", "text": "read or list files"},
    {"regex": "(^|[;&|(]\\s*)(rm|cp|mv|mkdir)\\s", "text": "move or delete files"},
    {"regex": "\\bpython3?\\s+-\\s|\\bpython3?\\s+-c\\b", "text": "inline Python script"},
    {"regex": "\\bpython3?\\s+\\S+", "text": "run a Python script"},
    {"regex": "\\b(node|tsx|deno)\\s+\\S+", "text": "run a JavaScript script"},
    {"regex": "\\bbash\\s+\\S+|(^|[;&|(]\\s*)\\./\\S+", "text": "run a shell script"}
  ]
}
